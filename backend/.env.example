# Application
APP_NAME=Cyber Attack Simulator
SECRET_KEY=replace-with-a-long-random-secret-before-production

# Database (SQLite is ready for local development)
DATABASE_URL=sqlite:///./cyber.db

# Optional local Ollama integration
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral

# Use the mock engine for a safe local simulation. Set these only when you have
# configured the Docker training lab described in docker/lab.
ATTACK_ENGINE=mock
DOCKER_ENABLED=false
